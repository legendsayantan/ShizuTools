<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:clipChildren="false">

    <!-- Button to open expanded menu, placed above top left corner of panel -->
    <ImageButton
        android:id="@+id/btn_more"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginStart="8dp"
        android:layout_marginBottom="4dp"
        android:background="@drawable/circle_green"
        android:backgroundTint="#80000000"
        android:src="@android:drawable/ic_menu_more"
        app:tint="#FFFFFF" />

    <com.google.android.material.card.MaterialCardView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:cardCornerRadius="16dp"
        app:strokeWidth="1dp"
        app:strokeColor="#4DFFFFFF"
        app:cardBackgroundColor="#CC202020"
        app:cardElevation="8dp"
        android:layout_margin="8dp"
        android:clipChildren="false">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:clipChildren="false"
            android:padding="8dp">

            <!-- Compact Container for dynamic vertical sliders (1 per app) -->
            <!-- It will contain item_mini_slider layouts dynamically injected -->
            <HorizontalScrollView
                android:id="@+id/mini_scroll_view"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:scrollbars="none">
                
                <LinearLayout
                    android:id="@+id/mini_sliders_container"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"/>
            </HorizontalScrollView>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
