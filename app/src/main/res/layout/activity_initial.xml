<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_paper">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp"
            android:gravity="center_horizontal">

            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <FrameLayout
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:layout_gravity="center_horizontal">
                <View
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:background="@drawable/bg_logo_circle" />
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_gravity="center"
                    app:cardCornerRadius="28dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp"
                    app:cardBackgroundColor="@color/transparent">
                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@mipmap/ic_launcher_round"
                        android:contentDescription="App Logo" />
                </com.google.android.material.card.MaterialCardView>
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="ShizuTools"
                android:textColor="?attr/colorOnBackground"
                android:textSize="32sp"
                android:fontFamily="@font/literata"
                android:letterSpacing="0.02"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Powered by Shizuku"
                android:textColor="?attr/colorOnSurface"
                android:textSize="14sp"
                android:fontFamily="@font/inter" />

            <!-- Explanation Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                app:cardBackgroundColor="?attr/colorSurface"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="?attr/colorOutline">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp"
                    android:gravity="center_vertical">
                    
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/outline_info_24"
                        app:tint="?attr/colorSecondary" />
                        
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:text="@string/role_shizuku"
                        android:textColor="?attr/colorOnBackground"
                        android:textSize="14sp"
                        android:fontFamily="@font/inter" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Steps Container -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:orientation="vertical">
                
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Connection Setup"
                    android:textColor="?attr/colorSecondary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textAllCaps="true"
                    android:letterSpacing="0.1"
                    android:layout_marginBottom="16dp"/>

                <!-- Step 1: Install -->
                <include layout="@layout/item_setup_step" android:id="@+id/step_install" />
                
                <View android:layout_width="2dp" android:layout_height="16dp" android:background="?attr/colorOutline" android:layout_marginStart="23dp" android:layout_marginTop="-4dp" android:layout_marginBottom="-4dp" android:id="@+id/line_1"/>
                
                <!-- Step 2: Start Service -->
                <include layout="@layout/item_setup_step" android:id="@+id/step_start" />

                <View android:layout_width="2dp" android:layout_height="16dp" android:background="?attr/colorOutline" android:layout_marginStart="23dp" android:layout_marginTop="-4dp" android:layout_marginBottom="-4dp" android:id="@+id/line_2"/>

                <!-- Step 3: Grant Permission -->
                <include layout="@layout/item_setup_step" android:id="@+id/step_permission" />

            </LinearLayout>

            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- Main Action Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_action"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="32dp"
                android:layout_marginBottom="16dp"
                android:text="Check Status"
                app:cornerRadius="28dp"
                android:fontFamily="@font/inter"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSecondary"
                app:backgroundTint="?attr/colorSecondary"
                app:icon="@drawable/baseline_refresh_24"
                app:iconGravity="textStart"
                app:iconTint="?attr/colorOnSecondary"/>

            <TextView
                android:id="@+id/version_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="v1.0"
                android:textColor="?attr/colorOutline"
                android:textSize="12sp"
                android:fontFamily="sans-serif" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
